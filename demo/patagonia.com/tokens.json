{
  "$description": "Patagonia brand tokens extracted from https://www.patagonia.com/home/ (2026-10-09)",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Black — monochrome brand: primary is the logo colour; fills 2 buttons"
    },
    "accent-1": {
      "$type": "color",
      "$value": "#1b2b79",
      "$description": "Dark Indigo — 9% of painted background"
    },
    "background": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "White — page background; fills 4 hero buttons"
    },
    "text": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Black — most-used text colour; fills 2 buttons"
    },
    "neutral-100": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "White — fills 4 hero buttons; link text (22% of links)"
    },
    "neutral-200": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Black — fills 2 buttons; link text (78% of links)"
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Ridgeway Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "Noto Sans",
          "Liberation Sans",
          "sans-serif",
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "Noto Color Emoji"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Ridgeway Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "Noto Sans",
          "Liberation Sans",
          "sans-serif",
          "Apple Color Emoji",
          "Segoe UI Emoji",
          "Segoe UI Symbol",
          "Noto Color Emoji"
        ]
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "64px",
        "fontWeight": 500,
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "32px",
        "fontWeight": 500,
        "lineHeight": 1,
        "letterSpacing": "-0.02em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "16px",
        "fontWeight": 300,
        "lineHeight": 1.5
      }
    },
    "list": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "14px",
        "fontWeight": 300,
        "lineHeight": 1.75
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "14px",
        "fontWeight": 300,
        "lineHeight": 1.75
      }
    },
    "nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "12px",
        "fontWeight": 300,
        "lineHeight": 1.5
      }
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": "30px"
    }
  }
}