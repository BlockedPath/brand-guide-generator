    },
    "text": {
      "$type": "color",
      "$value": "#777777",
      "$description": "Grey — most-used text colour; 63% of text"
    },
    "muted": {
      "$type": "color",
      "$value": "#4b4b4b",
      "$description": "Charcoal — heading text; 10% of text"
    },
    "border": {
      "$type": "color",
