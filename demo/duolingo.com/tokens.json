      "$description": "Light Grey — outlines 1 hero button"
    },
    "neutral-100": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "White — 100% of painted background"
    },
    "neutral-200": {
      "$type": "color",
      "$value": "#d8d8d8",
      "$description": "Light Grey — outlines 1 hero button"
    },
    "neutral-300": {
      "$type": "color",
      "$value": "#afaeaf",
