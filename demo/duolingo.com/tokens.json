  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "duolingo-sans",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "duolingo-sans",
          "sans-serif"
        ]
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "32px",
        "fontWeight": 700
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "feather",
        "fontSize": "48px",
        "fontWeight": 700
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "17px",
        "fontWeight": 500,
        "lineHeight": 1.41
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "15px",
        "fontWeight": 700,
        "lineHeight": 1.15,
        "letterSpacing": "0.05em"
      }
    },
    "nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "15px",
        "fontWeight": 700,
        "letterSpacing": "0.05em"
      }
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": "12px"
    }
  }
}