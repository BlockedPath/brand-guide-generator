{
  "$description": "Duolingo brand tokens extracted from https://www.duolingo.com/ (2026-10-09)",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#58cc02",
      "$description": "Vivid Lime — fills 1 hero button; heading text"
    },
    "secondary": {
      "$type": "color",
      "$value": "#1cb0f6",
      "$description": "Vivid Sky — link text (100% of links); 4% of text"
    },
    "accent-1": {
      "$type": "color",
      "$value": "#042c60",
      "$description": "Dark Navy — heading text; 6% of text"
