      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "nav": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.67,
        "letterSpacing": "-0.02em"
      }
