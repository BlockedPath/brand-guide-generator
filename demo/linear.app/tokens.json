{
  "$description": "Linear brand tokens extracted from https://linear.app/ (2026-10-09)",
  "color": {
    "primary": {
      "$type": "color",
      "$value": "#5e6ad2",
      "$description": "Indigo — brand colour declared as --color-brand-bg in the site's CSS; the interface itself uses #E5E5E6 for calls to action; named as a brand/primary token"
    },
    "background": {
      "$type": "color",
      "$value": "#08090a",
      "$description": "Black — page background; link text (18% of links)"
    },
    "surface": {
      "$type": "color",
      "$value": "#161718",
      "$description": "Near Black — 3% of painted background; used in gradients"
    },
    "text": {
      "$type": "color",
      "$value": "#d0d6e0",
      "$description": "Light Grey — most-used text colour; heading text"
    },
    "muted": {
      "$type": "color",
      "$value": "#8a8f98",
      "$description": "Grey — link text (82% of links); heading text"
    },
    "border": {
      "$type": "color",
      "$value": "#2e2e32",
      "$description": "Near Black — outlines 2 hero buttons"
    },
    "neutral-100": {
      "$type": "color",
      "$value": "#f7f8f8",
      "$description": "White — heading text; logo colour"
    },
    "neutral-200": {
      "$type": "color",
      "$value": "#e5e5e6",
      "$description": "Off-White — fills 1 hero button"
    },
    "neutral-300": {
      "$type": "color",
      "$value": "#d0d6e0",
      "$description": "Light Grey — heading text; 39% of text"
    },
    "neutral-400": {
      "$type": "color",
      "$value": "#8a8f98",
      "$description": "Grey — link text (82% of links); heading text"
    },
    "neutral-500": {
      "$type": "color",
      "$value": "#62666d",
      "$description": "Charcoal — 11% of text"
    },
    "neutral-600": {
      "$type": "color",
      "$value": "#2e2e32",
      "$description": "Near Black — outlines 2 hero buttons"
    },
    "neutral-700": {
      "$type": "color",
      "$value": "#08090a",
      "$description": "Black — link text (18% of links); declared theme-color"
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Inter Variable",
          "SF Pro Display",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Oxygen",
          "Ubuntu",
          "Cantarell",
          "Open Sans",
          "Helvetica Neue",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter Variable",
          "SF Pro Display",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Oxygen",
          "Ubuntu",
          "Cantarell",
          "Open Sans",
          "Helvetica Neue",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Berkeley Mono",
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ]
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "64px",
        "fontWeight": 510,
        "lineHeight": 1,
        "letterSpacing": "-0.02em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "48px",
        "fontWeight": 510,
        "lineHeight": 1,
        "letterSpacing": "-0.02em"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "20px",
        "fontWeight": 590,
        "lineHeight": 1.33,
        "letterSpacing": "-0.01em"
      }
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "16px",
        "fontWeight": 590,
        "lineHeight": 1.75
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    },
    "list": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "button": {
